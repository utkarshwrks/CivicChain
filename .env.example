# ═════════════════════════════════════════════════════════════════════════════
#  CivicChain v3 — backend environment (copy to .env, never commit .env)
#  Ethereum Sepolia testnet only. Test ETH / NFTs have NO monetary value.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Ethereum Sepolia ────────────────────────────────────────────────────────
# Sepolia JSON-RPC URL (free Alchemy / Infura key, or a public endpoint such as
# https://ethereum-sepolia-rpc.publicnode.com). May contain an API key — backend only.
SEPOLIA_RPC_URL=

# NEW Sepolia-only deployer + minter private key (0x + 64 hex). Pays gas for
# deployment and mints. Fund it from a free Sepolia faucet. Never reuse a key
# that was ever committed anywhere, never log or share it.
DEPLOYER_PRIVATE_KEY=

# Optional: separate minter wallet set at deploy time (defaults to the deployer).
MINTER_ADDRESS=

# Filled in after `npm run deploy:sepolia` (also read from deployments/sepolia.json).
NFT_CONTRACT_ADDRESS=
NFT_DEPLOYMENT_BLOCK=

# Optional: free Etherscan key, only for `npx hardhat verify`.
ETHERSCAN_API_KEY=

# Optional tuning (defaults shown)
# EXPECTED_CHAIN_ID=11155111
# MINT_CONFIRMATIONS=1
# MINT_TIMEOUT_MS=180000
# MINT_WAIT_MS=90000
# MAX_MINT_ATTEMPTS=5
# LOG_CHUNK_SIZE=1000
# EXPLORER_BASE_URL=https://sepolia.etherscan.io

# ─── Access control ──────────────────────────────────────────────────────────
# Comma-separated 0x addresses seeded as ADMIN on startup. If empty, the
# deployer address is seeded (use a separate admin wallet instead).
ADMIN_ADDRESSES=

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# >= 32 random characters. Required; production refuses to start without it.
JWT_SECRET=
# Allowed frontend origins (comma-separated).
CORS_ORIGINS=http://localhost:5173
# Upload size limit in MB.
MAX_UPLOAD_MB=10
# Public URL of the frontend, used for external_url in NFT metadata (optional).
FRONTEND_PUBLIC_URL=

# ─── Gemini Vision AI ────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey (free developer quota)
GEMINI_API_KEY=
# Optional: model + fallbacks tried in order when a model is retired, overloaded
# or rate-limited (defaults shown).
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# ─── Pinata IPFS ─────────────────────────────────────────────────────────────
# https://app.pinata.cloud → API Keys → New Key (pinFileToIPFS + pinJSONToIPFS) → JWT
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
