# CivicChain frontend — PUBLIC values only. Never put a key, JWT or RPC URL here:
# every VITE_* variable is compiled into the JavaScript that browsers download.

# Backend URL when the API is not served from the same origin (leave empty for single-deploy).
VITE_API_URL=

# Block explorer + IPFS gateway used for links (defaults shown).
VITE_EXPLORER_BASE_URL=https://sepolia.etherscan.io
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Where the "Download APK" buttons point (default: /downloads/CivicChain.apk served by the backend).
VITE_APK_URL=
